<link href="static/mdi/materialdesignicons.min.css" rel="stylesheet">
<style>
  @font-face {
    font-family: "Roboto";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("static/fonts/roboto-400.woff2") format("woff2");
  }
  @font-face {
    font-family: "Roboto";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("static/fonts/roboto-500.woff2") format("woff2");
  }
  :root {
    font-size: 14px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    --ha-primary: #03a9f4;
    --ha-card-shadow: 0 2px 2px 0 rgba(0,0,0,0.14), 0 3px 1px -2px rgba(0,0,0,0.12), 0 1px 5px 0 rgba(0,0,0,0.2);
    --ha-divider: rgba(0,0,0,0.12);
    --ha-primary-text-rgb: 0,0,0;
    --bs-primary: #03a9f4;
    --bs-primary-rgb: 3,169,244;
    --bs-link-color: #03a9f4;
    --bs-link-color-rgb: 3,169,244;
    --bs-link-hover-color: #0288d1;
    --bs-border-radius: 0.75rem;
    --bs-border-radius-lg: 0.75rem;
    --bs-border-radius-xl: 1rem;
    --bs-body-font-family: "Roboto", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, "Helvetica Neue", sans-serif;
    --bs-body-bg: #fafafa;
    --bs-body-color: #212121;
  }
  [data-bs-theme="dark"] {
    --bs-body-bg: #111111;
    --bs-body-color: #e0e0e0;
    --bs-bg-body-tertiary: #1c1c1c;
    --ha-divider: rgba(255,255,255,0.12);
    --ha-primary-text-rgb: 255,255,255;
    --ha-card-shadow: 0 2px 2px 0 rgba(0,0,0,0.5), 0 3px 1px -2px rgba(0,0,0,0.4), 0 1px 5px 0 rgba(0,0,0,0.6);
  }

  /* Flat full-width top app bar (breaks out of the body padding). */
  .app-bar {
    margin: -1rem -1rem 1rem -1rem;
    border-radius: 0;
    box-shadow: var(--ha-card-shadow);
    background: var(--bs-bg-body-tertiary, #fff) !important;
  }
  [data-bs-theme="dark"] .app-bar { background: #1c1c1c !important; }
  .app-bar .navbar-toggler { border: none; }
  @media (max-width: 991.98px) {
    .app-bar .navbar-collapse {
      border-top: 1px solid var(--ha-divider);
      margin-top: 0.5rem;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
    .app-bar .navbar-collapse .nav-link { padding: 0.5rem 1rem; }
    .app-bar .navbar-collapse .navbar-text { padding-left: 1rem; padding-right: 1rem; }
  }

  /* Material (HA) buttons: pill, uppercase, medium weight. */
  .btn {
    border-radius: 100px;
    text-transform: uppercase;
    font-weight: 500;
    letter-spacing: .4px;
    --bs-btn-padding-y: 0.375rem;
    --bs-btn-padding-x: 1.15rem;
  }
  .btn-sm { --bs-btn-padding-y: 0.25rem; --bs-btn-padding-x: 0.85rem; }
  .btn-primary {
    --bs-btn-bg: #03a9f4;
    --bs-btn-border-color: #03a9f4;
    --bs-btn-color: #fff;
    --bs-btn-hover-bg: #0288d1;
    --bs-btn-hover-border-color: #0288d1;
    --bs-btn-hover-color: #fff;
    --bs-btn-active-bg: #0277bd;
    --bs-btn-active-border-color: #0277bd;
    --bs-btn-active-color: #fff;
  }
  .btn-primary:hover, .btn-primary:active, .btn-primary:focus { color: #fff !important; }

  /* Flat HA icon button (borderless, circular hover) for row menus. */
  .ha-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--bs-secondary-color);
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .ha-icon-btn:hover { background: rgba(var(--ha-primary-text-rgb), 0.08); }

  /* HA data-table look: 52px rows, 56px header, dividers, subtle row hover. */
  .ha-table { --bs-table-bg: transparent; }
  .ha-table thead th {
    height: 56px;
    padding: 0 16px;
    font-size: .875rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: .0178em;
    color: var(--bs-body-color);
    white-space: nowrap;
  }
  .ha-table thead th.text-end { text-align: right; }
  .ha-table tbody td {
    height: 52px;
    padding: 8px 16px;
    font-size: .875rem;
    line-height: 1.2;
    letter-spacing: .0178em;
    color: var(--bs-body-color);
    border-top: 1px solid var(--ha-divider);
    vertical-align: middle;
  }
  .ha-table tbody td.text-end { text-align: right; }
  .ha-table tbody tr:hover td { background: rgba(var(--ha-primary-text-rgb), .04); }

  .table { --bs-table-bg: transparent; }
  .card { border: none; box-shadow: var(--ha-card-shadow); }

  /* HA state badge: compact colored pill. */
  .status-badge {
    display: inline-block;
    min-width: 2.2rem;
    padding: 0.15rem 0.55rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: .3px;
    text-transform: uppercase;
    text-align: center;
    color: #fff;
    background: var(--bs-secondary-color);
    vertical-align: middle;
  }
  .status-badge.is-green { background: var(--bs-success); }
  .status-badge.is-yellow { background: var(--bs-warning); color: #1a1a1a; }
  .status-badge.is-red { background: var(--bs-danger); }
  .status-badge.is-broken {
    background: transparent;
    border: 1.5px solid var(--bs-danger);
    color: var(--bs-danger);
    box-sizing: border-box;
  }
  /* "example" marker on read-only bundled example flows. */
  .example-badge {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--bs-secondary-color);
    font-size: 0.65rem;
    letter-spacing: .3px;
    text-transform: uppercase;
    color: var(--bs-secondary-color);
    vertical-align: middle;
  }

  .nav-link { color: var(--bs-body-color); opacity: 0.7; }
  .nav-link.active, .nav-link:hover { opacity: 1; color: #03a9f4; }

  /* MDI icons track the surrounding font-size. */
  .mdi::before { font-size: inherit; }
</style>
