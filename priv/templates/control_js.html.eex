// Session-lapse guard. If auth is lost while a page is open (cookie expiry,
// logout in another tab, or an admin deleting/role-changing the account —
// each drops the live session), the next /api/* call 401s. Send the browser
// back to /login instead of leaving a blank, half-dead page.
(function () {
  const real = window.fetch;
  window.fetch = function (input, init) {
    return real(input, init).then((res) => {
      const url = typeof input === "string" ? input : (input && input.url) || "";
      if (res.status === 401 && url.indexOf("api/") === 0 && url.indexOf("api/login") < 0) {
        location.href = __BASE__ ? __BASE__ + "/login" : "login";
      }
      return res;
    });
  };
  // Idle safety net: catch a session that lapses while the page sits open.
  setInterval(() => { window.fetch("api/me"); }, 30000);
})();
// Dep-install progress ticker. Each install pushes fetch/compile/load/done lines;
// the newest sits at the bottom, each new line pushes the older up while it fades,
// and the whole stack clears when the build finishes (or fails). Built once.
(function () {
  if (document.getElementById("dep-banner")) return;
  const style = document.createElement("style");
  style.textContent =
    "#dep-banner{position:fixed;bottom:1.25rem;left:50%;transform:translateX(-50%);" +
    "z-index:1050;pointer-events:none;display:flex;flex-direction:column;align-items:center;gap:.35rem}" +
    ".dep-row{display:flex;align-items:center;gap:.5rem;padding:.4rem .8rem;border-radius:.6rem;" +
    "background:rgba(33,37,41,.82);color:#fff;font-size:.85rem;box-shadow:0 2px 10px rgba(0,0,0,.25);" +
    "opacity:1;transform:translateY(0);transition:opacity .35s ease,transform .35s ease}" +
    ".dep-row.enter{opacity:0;transform:translateY(12px)}" +
    ".dep-row.leave{opacity:0;transform:translateY(-12px)}";
  document.head.appendChild(style);
  const box = document.createElement("div");
  box.id = "dep-banner";
  document.body.appendChild(box);
})();
function depLeaveRow(r) {
  const s = r.querySelector(".spinner-border");
  if (s) s.remove();
  r.classList.add("leave");
  setTimeout(() => r.remove(), 450);
}
function depBanner(msg) {
  const box = document.getElementById("dep-banner");
  if (!box) return;
  if (msg.phase === "done") {
    box.querySelectorAll(".dep-row").forEach(depLeaveRow);
    return;
  }
  const row = document.createElement("div");
  row.className = "dep-row enter";
  row.innerHTML = '<div class="spinner-border spinner-border-sm" role="status"></div><span></span>';
  row.querySelector("span").textContent = msg.message || "";
  box.appendChild(row);
  requestAnimationFrame(() => requestAnimationFrame(() => row.classList.remove("enter")));
  const all = box.querySelectorAll(".dep-row");
  for (let i = 0; i < all.length - 1; i++) depLeaveRow(all[i]);
}
function setSnapshot(el, value) {
  el.innerHTML = "";
  if (value) {
    const img = document.createElement("img");
    img.src = value; img.className = "img-fluid rounded"; img.style.maxWidth = "220px";
    el.appendChild(img);
  } else {
    const s = document.createElement("span");
    s.className = "text-secondary small"; s.textContent = "no snapshot yet";
    el.appendChild(s);
  }
}
function renderTable(el, value) {
  el.innerHTML = "";
  const cols = (value && value.cols) || [];
  const rows = (value && value.rows) || [];
  if (!rows.length) {
    const s = document.createElement("span");
    s.className = "text-secondary small"; s.textContent = "no data yet";
    el.appendChild(s);
    return;
  }
  const t = document.createElement("table");
  t.className = "table table-sm align-middle mb-0 ha-table";
  const head = document.createElement("thead");
  const hr = document.createElement("tr");
  for (const c of cols) { const th = document.createElement("th"); th.textContent = c; hr.appendChild(th); }
  head.appendChild(hr); t.appendChild(head);
  const body = document.createElement("tbody");
  for (const r of rows) {
    const tr = document.createElement("tr");
    for (const cell of r) {
      const td = document.createElement("td");
      td.textContent = (cell === null || cell === undefined) ? "-" : String(cell);
      tr.appendChild(td);
    }
    body.appendChild(tr);
  }
  t.appendChild(body); el.appendChild(t);
}
function renderControl(e, btnClass) {
  if (e.type === "state") {
    const b = document.createElement("span");
    const on = e.value === true || e.value === "on";
    const off = e.value === false || e.value === "off";
    b.className = "badge " + (on ? "bg-success" : off ? "bg-secondary" : "bg-info text-dark");
    b.textContent = (e.label || e.node) + ": " + (e.value === null || e.value === undefined ? "-" : e.value);
    b.dataset.flow = e.name;
    b.dataset.node = e.node;
    b.dataset.label = e.label || e.node;
    return b;
  }
  if (e.type === "image") {
    const wrap = document.createElement("span");
    wrap.className = "d-inline-flex align-items-center";
    wrap.dataset.flow = e.name;
    wrap.dataset.node = e.node;
    wrap.dataset.label = e.label || e.node;
    wrap.dataset.snapshot = "1";
    setSnapshot(wrap, e.value);
    return wrap;
  }
  if (e.type === "table") {
    const wrap = document.createElement("div");
    wrap.className = "w-100";
    wrap.style.maxHeight = "340px"; wrap.style.overflow = "auto";
    wrap.dataset.flow = e.name;
    wrap.dataset.node = e.node;
    wrap.dataset.label = e.label || e.node;
    wrap.dataset.table = "1";
    renderTable(wrap, e.value);
    return wrap;
  }
  const b = document.createElement("button");
  b.className = "btn " + (btnClass || "btn-primary");
  b.textContent = e.label || e.node;
  b.onclick = async () => {
    await fetch("api/ui/click", { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name: e.name, node: e.node, payload: e.payload }) });
  };
  return b;
}
// Reconnect-with-backoff web socket. `handlers` maps a push `type` to a fn(msg).
function connectUI(handlers, onOpen, retryMs) {
  handlers = Object.assign({ dep: depBanner }, handlers);
  const proto = location.protocol === "https:" ? "wss://" : "ws://";
  const ws = new WebSocket(proto + location.host + __BASE__ + "/api/ui/ws");
  if (onOpen) ws.onopen = () => onOpen();
  ws.onmessage = (e) => {
    try { const m = JSON.parse(e.data); if (handlers[m.type]) handlers[m.type](m); } catch (_) {}
  };
  ws.onclose = () => setTimeout(() => connectUI(handlers, onOpen, retryMs), retryMs || 2000);
  return ws;
}
// Update one badge from a pushed {flow, node, value} update. Pushes carry
// the flow's short name, so also match the last segment of path-style names.
function updateBadge(u) {
  const el = [...document.querySelectorAll('[data-node="' + u.node + '"]')].find(
    (b) => b.dataset.flow === u.flow || b.dataset.flow.split("/").pop() === u.flow);
  if (!el) return;
  if (el.dataset.table) { renderTable(el, u.value); return; }
  if (el.dataset.snapshot) { setSnapshot(el, u.value); return; }
  el.textContent = el.dataset.label + ": " + (u.value === null || u.value === undefined ? "-" : u.value);
}
// A config key row. `flowName` null -> global scope via api/config; a flow
// name -> api/flows/<name>/config, writing the key at its current scope
// (`it.source`, so a global-sourced key edits the global value).
function cfgRow(it, flowName, onDone) {
  const row = document.createElement("div");
  row.className = "d-flex align-items-center gap-2 mb-1 flex-wrap";
  const label = document.createElement("span");
  label.className = "small text-truncate" + (it.secret ? " font-mono" : "");
  label.style.minWidth = "140px";
  label.title = it.key;
  label.textContent = it.key;
  const input = document.createElement("input");
  input.className = "form-control form-control-sm";
  input.type = it.secret ? "password" : "text";
  input.value = it.value == null ? "" : String(it.value);
  input.dataset.revealed = "0";
  const url = flowName ? "api/flows/" + flowName + "/config" : "api/config";
  const post = async (value) => {
    const body = { key: it.key, value };
    if (flowName) body.scope = it.source || "flow";
    const r = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body) });
    if (!r.ok) {
      const e = await r.json().catch(() => ({}));
      alert("config " + it.key + ": " + (e.error || r.statusText));
    } else onDone();
  };
  const save = document.createElement("button");
  save.className = "btn btn-sm btn-outline-primary";
  save.textContent = "Save";
  save.onclick = () => post(input.value);
  const del = document.createElement("button");
  del.className = "btn btn-sm btn-outline-danger";
  del.textContent = "Delete";
  del.onclick = () => post(null);
  const kids = [label, input];
  if (flowName) {
    const badge = document.createElement("span");
    badge.className = "badge " + (it.source === "global" ? "bg-secondary" : "bg-info text-dark");
    badge.title = it.source === "global" ? "set globally (applies to all flows)" : "set for this flow";
    badge.textContent = it.source;
    kids.push(badge);
  }
  kids.push(save, del);
  if (it.secret) {
    const reveal = document.createElement("button");
    reveal.className = "btn btn-sm btn-outline-secondary";
    reveal.textContent = "show";
    reveal.onclick = () => {
      const shown = input.dataset.revealed === "1";
      input.type = shown ? "password" : "text";
      input.dataset.revealed = shown ? "0" : "1";
      reveal.textContent = shown ? "show" : "hide";
    };
    kids.push(reveal);
  }
  for (const k of kids) row.appendChild(k);
  return row;
}
