<%= base %>
  <div class="card">
    <div class="card-header"><span class="fw-semibold">Config</span></div>
    <div class="card-body">
      <p class="text-secondary small mb-3">Pick <b>Global</b> for values shared across all
      flows, or a flow to see and set its values. A flow-specific value (blue badge)
      overrides the global one (grey badge); saving a badged row writes at that row's
      scope. Secret-looking keys are masked.</p>
      <div class="d-flex gap-2 mb-3 flex-wrap">
        <label class="small align-self-center">Scope</label>
        <select id="cfg-flow" class="form-select form-select-sm" style="max-width:280px">
          <option value="">Global (all flows)</option>
        </select>
      </div>
      <div class="d-flex gap-2 mb-3">
        <input id="new-key" class="form-control form-control-sm" placeholder="new key" style="max-width:220px">
        <input id="new-val" class="form-control form-control-sm" placeholder="value">
        <button id="add-btn" class="btn btn-sm btn-primary">Add</button>
      </div>
      <div id="cfg-list"></div>
    </div>
  </div>
  <script>
    <%= control_js %>
    async function fail(what, r) {
      const e = await r.json().catch(() => ({}));
      alert(what + ": " + (e.error || r.statusText));
    }
    function sel() { return document.getElementById("cfg-flow").value; }
    async function loadFlowsIntoSelect() {
      const s = document.getElementById("cfg-flow");
      try {
        const all = await (await fetch("api/flows")).json();
        if (all && !all.busy) for (const f of all.sort((a, b) => (a.name < b.name ? -1 : 1))) {
          const o = document.createElement("option");
          o.value = f.name; o.textContent = f.name;
          s.appendChild(o);
        }
      } catch (_) {}
    }
    async function loadConfig() {
      const box = document.getElementById("cfg-list");
      const flow = sel();
      let items;
      try {
        items = await (await fetch(flow ? "api/flows/" + flow + "/config" : "api/config")).json();
      } catch (_) { box.innerHTML = '<span class="text-danger">failed to load</span>'; return; }
      box.innerHTML = "";
      if (!items.length) {
        box.innerHTML = '<span class="text-secondary small">' +
          (flow ? "no config (load the flow to seed defaults)" : "no global keys yet") + "</span>";
        return;
      }
      for (const it of items) box.appendChild(cfgRow(it, flow || null, loadConfig));
    }
    document.getElementById("cfg-flow").onchange = loadConfig;
    document.getElementById("add-btn").onclick = async () => {
      const key = document.getElementById("new-key").value.trim();
      const val = document.getElementById("new-val").value;
      if (!key) return;
      const flow = sel();
      const body = { key, value: val };
      if (flow) body.scope = "flow";
      const r = await fetch(flow ? "api/flows/" + flow + "/config" : "api/config",
        { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
      if (r.ok) {
        document.getElementById("new-key").value = "";
        document.getElementById("new-val").value = "";
        loadConfig();
      } else fail("add " + key, r);
    };
    loadFlowsIntoSelect().then(loadConfig);
    connectUI({ flow_changed: loadConfig });
  </script>
